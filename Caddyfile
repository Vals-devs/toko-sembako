# Konfigurasi Caddy untuk Toko Sembako PWA via Ngrok
# Caddy berjalan pada port HTTP 80 karena SSL telah ditangani otomatis oleh Ngrok Cloud

:80 {
    # Mengarahkan request API, docs, dan openapi ke service backend FastAPI
    reverse_proxy /api/* backend:7860
    reverse_proxy /docs backend:7860
    reverse_proxy /openapi.json backend:7860

    # Mengarahkan request lainnya ke service frontend Vue 3
    reverse_proxy frontend:80

    # Mengaktifkan kompresi gzip & zstd untuk menghemat bandwidth
    encode gzip zstd
}
